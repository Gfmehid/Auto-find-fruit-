local function SendDiscordWebhook(fruitName)
    local webhook = getgenv().NexusConfig.DiscordWebhook
    if not webhook or webhook == "" then return end
    
    pcall(function()
        local data = {
            ["content"] = "@everyone",
            ["embeds"] = {
                {
                    ["title"] = "🍎 Fruta Valiosa Encontrada & Guardada!",
                    ["description"] = string.format("O bot recolheu com sucesso e guardou a fruta **%s** no baú!", fruitName),
                    ["color"] = 65280, -- Verde brilhante
                    ["fields"] = {
                        { ["name"] = "Servidor (JobId)", ["value"] = "```" .. game.JobId .. "```", ["inline"] = false }
                    },
                    ["footer"] = { ["text"] = "Nova Nexus | Ultimate Fruit Hub" },
                    ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
                }
            }
        }
        
        local req = (syn and syn.request) or request or http_request or (fluxus and fluxus.request)
        if req then
            req({
                Url = webhook,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(data)
            })
        end
    end)
end

