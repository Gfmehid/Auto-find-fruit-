-- ==========================================
-- MOTOR DE HOP OFICIAL OTIMIZADO E RÁPIDO
-- ==========================================
module.HopServers = function(counts)
    if counts == nil then counts = 10 end
    AutoExecuteSetup()
    
    spawn(function()
        for r = 1, math.huge do
            local success, res = pcall(function()
                return game.ReplicatedStorage.__ServerBrowser:InvokeServer(r)
            end)
            if success and res then
                for k, v in next, res do
                    if k ~= game.JobId and v["Count"] <= counts then
                        Notify("Server Manager", "A mudar para o servidor otimizado...", 3)
                        game.ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", k)
                        return
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end

-- ==========================================
-- SISTEMA DE NOCLIP & TWEEN BALANCEADO
-- ==========================================
local NoClipActive = false
spawn(function()
    while task.wait(0.1) do
        pcall(function()
            if NoClipActive and plr.Character then
                for _, v in pairs(plr.Character:GetDescendants()) do
                    if v:IsA("BasePart") then
                        v.CanCollide = false
                    end
                end
            end
        end)
    end
end)

local function BalancedTween(targetCFrame)
    local char = plr.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    NoClipActive = true
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = Settings["Tween Speed"]
    local timeToTravel = distance / speed
    
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()
    NoClipActive = false
end

-- ==========================================
-- SELETOR DE FRUTAS
-- ==========================================
local function GetTargetFruit()
    local pref = getgenv().NexusConfig.PreferredFruit
    
    for _, v in pairs(workspace:GetChildren()) do
        if (v:IsA("Tool") or v:IsA("Model")) and (string.find(v.Name, "Fruit") or string.find(v.Name, "Physical")) then
            local handle = v:FindFirstChild("Handle") or v:FindFirstChildWhichIsA("BasePart")
            if handle then
                if pref == "Any" then
                    return v
                elseif type(pref) == "table" then
                    for _, fruitName in ipairs(pref) do
                        if string.find(v.Name, fruitName) then
                            return v
                        end
                    end
                elseif type(pref) == "string" then
                    if string.find(v.Name, pref) then
                        return v
                    end
                end
            end
        end
    end
    return nil
end

